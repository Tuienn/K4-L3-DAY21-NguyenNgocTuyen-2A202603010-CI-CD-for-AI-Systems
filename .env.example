# Copy to .env, then load with: set -a; source .env; set +a
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=adult-income

# Fill these after creating Azure Blob Storage. ARTIFACT_BUCKET is the container.
ARTIFACT_BUCKET=income-lab
AZURE_STORAGE_CONNECTION_STRING=''
